{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxlint": "explicit"
  },
  "oxc_lsp.enable": true,
  "oxlinter": "linter",
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/.turbo/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/.turbo": true
  }
}
