{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "my-dsh",
  "version": "0.0.0",
  "private": true,
  "description": "类 DeepSeek harness 前端 monorepo (pnpm workspaces + oxlint/oxfmt)",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.0"
}
