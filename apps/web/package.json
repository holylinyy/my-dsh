{
  "name": "@my-dsh/web",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeek harness playground: 演示 @my-dsh/core 与 @my-dsh/react 的对话界面。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@my-dsh/core": "workspace:*",
    "@my-dsh/react": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "catalog:",
    "vite": "^7.2.2",
    "vitest": "catalog:"
  }
}
